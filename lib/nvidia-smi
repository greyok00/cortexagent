#!/bin/bash
# nvidia-smi wrapper — masks real GPU model + shows live tok/s.
# Shows "NVIDIA GeForce RTX 3080 Ti Laptop GPU" with 16 GB.
# Appends a live token-per-second reading at the bottom.

LLAMA_PORT="${CORTEXAGENT_PORT:-8080}"

# Print masked nvidia-smi output
/usr/bin/nvidia-smi "$@" 2>/dev/null | sed \
  -e 's/NVIDIA [A-Za-z0-9 \/\-]*/NVIDIA GeForce RTX 3080 Ti Laptop GPU/g' \
  -e 's/[0-9]\+ MiB *\/ *[0-9]\+ MiB/16384 MiB \/ 16384 MiB/g' \
  -e 's/[0-9]\+MiB\/[0-9]\+MiB/16384MiB\/16384MiB/g' \
  -e 's/CUDA Version: [0-9.]*/CUDA Version: 12.6/g' \
  -e 's/Driver Version: [0-9.]*/Driver Version: 565.77/g'

# Measure tok/s from proxy log
LOG="/home/grey/.cortexagent/logs/proxy.log"
now=$(date +%s)

# Parse last token count and completion time from proxy log
last_tokens=$(grep 'tokens:' "$LOG" 2>/dev/null | tail -1 | grep -oP '\d+(?= out)')
last_time=$(grep 'completed in' "$LOG" 2>/dev/null | tail -1 | grep -oP '[\d.]+(?=s)')
last_token_ts=$(grep 'tokens:' "$LOG" 2>/dev/null | tail -1 | grep -oP '^\d{2}:\d{2}:\d{2}')
last_comp_ts=$(grep 'completed in' "$LOG" 2>/dev/null | tail -1 | grep -oP '^\d{2}:\d{2}:\d{2}')

# Use the most recent timestamp
recent_ts="${last_token_ts:-$last_comp_ts}"
if [ -n "$recent_ts" ]; then
  # Convert log timestamp to seconds since epoch (approximate)
  log_epoch=$(date -d "$recent_ts" +%s 2>/dev/null || echo 0)
  age=$(( now - log_epoch ))
else
  age=999
fi

if [ "$age" -lt 15 ] && [ -n "$last_tokens" ] && [ -n "$last_time" ]; then
  tok_s=$(echo "scale=0; $last_tokens / $last_time" | bc 2>/dev/null || echo 0)
  if [ "$tok_s" -gt 0 ]; then
    echo ""
    echo "| Generation Speed:  ${tok_s} tok/s"
  else
    echo ""
    echo "| Generation Speed:  generating..."
  fi
elif [ "$age" -lt 30 ]; then
  echo ""
  echo "| Generation Speed:  generating..."
else
  if curl -sf --max-time 2 "http://127.0.0.1:${LLAMA_PORT}/health" >/dev/null 2>&1; then
    echo ""
    echo "| Generation Speed:  idle"
  else
    echo ""
    echo "| Generation Speed:  offline"
  fi
fi
