import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import { type Component, truncateToWidth, visibleWidth } from "@cortex/tui";
import { theme } from "../theme/theme.ts";

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STATUS BAR — compact 3-panel bordered table under the chat window.
//
//   ┌─ ⚡ Compression ────────┐ ┌─ 🧠 Memory ────────────┐ ┌─ 📅 Tasks ────────────┐
//   │ ⠋ 42% saved · 4 runs     │ │ 29 cold · 12 hot       │ │ ▶ running web-dap     │
//   │ 25.1k in → 14.5k out      │ │ topic: web-dap         │ │ 2 queued              │
//   └──────────────────────────┘ └────────────────────────┘ └────────────────────────┘
//
// Reads REAL data from the live stores:
//   - Compression : ~/.cortexagent/token_tracker.json
//   - Memory      : ~/.config/cortexllm/memory/{cold,hot}/
//   - Tasks       : ~/.cortexagent/scheduler/tasks.json
//   - Topic       : latest user prompt in hot memory, keywords matched to cold domains
//
// Exactly 4 lines, always. A 500ms timer cycles a spinner char in the
// compression panel; the TUI's incremental renderer redraws only that one
// line in place, so the animation never spams the scrollback.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const HOME = os.homedir();
const SCHEDULER_FILE = path.join(HOME, ".cortexagent", "scheduler", "tasks.json");
// Real activity source: events.jsonl is the append-only history of every
// task created/started/done/failed. tasks.json is the snapshot — it
// empties out as soon as everything finishes, so reading it alone makes
// the Tasks panel look dead. Merge the two so scheduled-but-not-yet-run
// tasks are visible.
const SCHEDULER_EVENTS = path.join(HOME, ".cortexagent", "scheduler", "tasks.events.jsonl");
// Legacy source: minify_stats.json was written by the grammar proxy
// (grammar_proxy.py), deleted 2026-09-22. The optimizer lanes are slimtoken
// :11435 (cloud) / :11436 (local) → ollama :11600; they report their own
// metrics, so this file no longer updates and the panels read "(no data)".
const TOKEN_FILE = path.join(HOME, ".local", "state", "slimtoken", "stats.json");
// Legacy location — read as fallback if the slimtoken state file is absent.
const TOKEN_FILE_LEGACY = path.join(HOME, ".cortexagent", "minify_stats.json");
const COLD_DIR = path.join(HOME, ".config", "cortexllm", "memory", "cold");
const HOT_DIR = path.join(HOME, ".config", "cortexllm", "memory", "hot");

const SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];

// ── Sanitize: strip URLs, JSON braces/quotes, control chars, collapse space ─
function sanitize(text: string): string {
	return text
		.replace(/https?:\/\/\S+/g, "[link]")
		.replace(/[{}[\]"\\]/g, " ")
		.replace(/[\r\n\t]+/g, " ")
		.replace(/\s+/g, " ")
		.trim();
}

function formatNum(n: number): string {
	if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
	if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
	return String(n);
}

// ── Data readers ────────────────────────────────────────────────────────────

interface SchedulerTask {
	title?: string;
	state?: string;
	status?: string;
}

function readScheduler(): { tasks: SchedulerTask[]; ok: boolean; missing: boolean } {
	// Distinguish "file doesn't exist" (no scheduler → "no scheduler")
	// from "file exists but empty {}" (scheduler is up, just idle →
	// "✓ idle"). User feedback 2026-08-20: empty tasks.json should NOT
	// render as "no scheduler"; the scheduler is clearly there.
	//
	// 2026-08-21: tasks.json is a FLAT DICT keyed by task-id (the
	// scheduler writes entries as {id: {title, state, ...}}), not the
	// {tasks: [...]} envelope the old reader assumed. The mismatch
	// made `data.tasks` always empty → panel permanently showed "no
	// active jobs" even when the scheduler had dozens of queued/running
	// tasks. Accept BOTH shapes (array envelope OR flat dict).
	try {
		if (!fs.existsSync(SCHEDULER_FILE)) return { tasks: [], ok: false, missing: true };
		const data = JSON.parse(fs.readFileSync(SCHEDULER_FILE, "utf8"));
		let tasks: SchedulerTask[];
		if (Array.isArray(data.tasks)) {
			tasks = data.tasks;
		} else if (data && typeof data === "object" && !Array.isArray(data)) {
			// Flat dict {id: {title, state, ...}} — values are the tasks.
			tasks = Object.values(data) as SchedulerTask[];
		} else {
			tasks = [];
		}
		return { tasks, ok: true, missing: false };
	} catch {
		return { tasks: [], ok: false, missing: false };
	}
}

/** All tasks ever touched, derived from the append-only event log.
 *
 * Merges the snapshot (state.json / tasks.json — current authoritative state)
 * with the events log so scheduled-but-not-yet-running tasks are still
 * visible. Returns a list of {id, title, state, ts}. Out-of-order events are
 * resolved by last-write-wins on `task_id`. Falls back to the snapshot alone
 * when the event log is missing.
 */
function readLiveActivity(): { id: string; title: string; state: string; ts: string }[] {
	const byId = new Map<string, { id: string; title: string; state: string; ts: string }>();
	// Latest known per id from the snapshot.
	// 2026-08-21: tasks.json may be a flat dict keyed by id, not the
	// {tasks: [...]} envelope. Accept BOTH.
	try {
		if (fs.existsSync(SCHEDULER_FILE)) {
			const data = JSON.parse(fs.readFileSync(SCHEDULER_FILE, "utf8"));
			const snapshot: any[] = Array.isArray(data.tasks)
				? data.tasks
				: data && typeof data === "object" && !Array.isArray(data)
					? Object.values(data)
					: [];
			for (const t of snapshot) {
				const id = String(t.id ?? "");
				if (!id) continue;
				byId.set(id, {
					id,
					title: String(t.title ?? "(untitled)"),
					state: String(t.state ?? t.status ?? "scheduled"),
					ts: String(t.next_run_at ?? t.last_run_at ?? t.updated_at ?? ""),
				});
			}
		}
	} catch {
		/* ignore */
	}
	// Events overwrite state by ts ordering (last-write-wins per task_id).
	try {
		if (fs.existsSync(SCHEDULER_EVENTS)) {
			const lines = fs.readFileSync(SCHEDULER_EVENTS, "utf8").split("\n");
			for (const raw of lines) {
				const line = raw.trim();
				if (!line) continue;
				let ev: any;
				try {
					ev = JSON.parse(line);
				} catch {
					continue;
				}
				const id = String(ev.task_id ?? "");
				if (!id) continue;
				const ts = String(ev.timestamp ?? "");
				const cur = byId.get(id);
				// If we already have a newer event for this id, skip.
				if (cur && cur.ts && ts && cur.ts >= ts) continue;
				// Map event type → state. Unknown types preserve current state.
				let state = cur?.state ?? "scheduled";
				if (ev.type === "create") state = "scheduled";
				else if (ev.type === "queue" || ev.type === "queued") state = "queued";
				else if (ev.type === "start" || ev.type === "running") state = "running";
				else if (ev.type === "done" || ev.type === "succeeded") state = "succeeded";
				else if (ev.type === "fail" || ev.type === "failed") state = "failed";
				else if (ev.type === "cancel") state = "cancelled";
				byId.set(id, {
					id,
					title: String(ev.data?.title ?? cur?.title ?? "(untitled)"),
					state,
					ts,
				});
			}
		}
	} catch {
		/* ignore */
	}
	// Filter out terminal states so the panel surfaces what's actually live.
	// User feedback 2026-08-20: "STILL HAS THE FUCKING SCHEDULED TASK LIST IN
	// THE MAIN TEXT" — seeded tasks with state="scheduled" but no actual
	// queue/run event are still "scheduled" but not actionable. Only show
	// tasks that have actually fired (queued or running). Seeded/manual tasks
	// with no event-driven state stay invisible until they move.
	const live = ["queued", "running"];
	const out = Array.from(byId.values()).filter((t) => live.includes(t.state));
	// Sort: running first, then queued, then scheduled; tie-break by ts.
	const order = (s: string) => (s === "running" ? 0 : s === "queued" ? 1 : 2);
	out.sort((a, b) => {
		const o = order(a.state) - order(b.state);
		if (o !== 0) return o;
		return (a.ts || "").localeCompare(b.ts || "");
	});
	return out;
}

/** Count of `done` / `succeeded` events in the last hour. Used so the
 * Idle panel can say "5 done recently" instead of looking dead forever. */
function countRecentCompleted(): number {
	let n = 0;
	const cutoff = Date.now() - 60 * 60 * 1000;
	try {
		if (!fs.existsSync(SCHEDULER_EVENTS)) return 0;
		for (const raw of fs.readFileSync(SCHEDULER_EVENTS, "utf8").split("\n")) {
			const line = raw.trim();
			if (!line) continue;
			let ev: any;
			try {
				ev = JSON.parse(line);
			} catch {
				continue;
			}
			if (ev.type !== "done" && ev.type !== "succeeded") continue;
			const ts = Date.parse(String(ev.timestamp ?? ""));
			if (Number.isFinite(ts) && ts >= cutoff) n++;
		}
	} catch {
		/* ignore */
	}
	return n;
}

function readSlimToken(): {
	runs: number;
	tokensIn: number;
	tokensOut: number;
	saved: number;
	ratio: number;
	ok: boolean;
} {
	try {
		const file = fs.existsSync(TOKEN_FILE) ? TOKEN_FILE : TOKEN_FILE_LEGACY;
		if (!fs.existsSync(file)) return { runs: 0, tokensIn: 0, tokensOut: 0, saved: 0, ratio: 0, ok: false };
		const d = JSON.parse(fs.readFileSync(file, "utf8"));
		// minify_stats.json is flat; token_tracker.json wraps under `total`.
		const t = d.total ?? d;
		return {
			runs: t.runs ?? 0,
			tokensIn: t.tokens_in ?? 0,
			tokensOut: t.tokens_out ?? 0,
			saved: t.tokens_saved ?? 0,
			ratio: t.ratio_pct ?? 0,
			ok: true,
		};
	} catch {
		return { runs: 0, tokensIn: 0, tokensOut: 0, saved: 0, ratio: 0, ok: false };
	}
}

function readMemoryCounts(): { cold: number; hot: number; recent: { cold: number; hot: number } } {
	let cold = 0;
	let hot = 0;
	let recentCold = 0;
	let recentHot = 0;
	// 24h ago — used to surface "is anything actually being written?".
	// User feedback 2026-08-20: "memory is playing right there, doesn't
	// even work, it doesn't capture any information, doesn't upload the
	// memory, doesn't update anything."  A blank "30 cold / 29 hot"
	// could mean either a rich corpus or a dead system. Show the
	// 24h write count so the user can tell at a glance.
	const cutoff = Date.now() - 24 * 60 * 60 * 1000;
	try {
		if (fs.existsSync(COLD_DIR)) {
			for (const f of fs.readdirSync(COLD_DIR)) {
				if (!f.endsWith(".json")) continue;
				cold++;
				try {
					const st = fs.statSync(path.join(COLD_DIR, f));
					if (st.mtimeMs >= cutoff) recentCold++;
				} catch {
					/* ignore */
				}
			}
		}
	} catch {
		/* ignore */
	}
	try {
		if (fs.existsSync(HOT_DIR)) {
			for (const f of fs.readdirSync(HOT_DIR)) {
				if (!f.endsWith(".jsonl")) continue;
				hot++;
				try {
					const st = fs.statSync(path.join(HOT_DIR, f));
					if (st.mtimeMs >= cutoff) recentHot++;
				} catch {
					/* ignore */
				}
			}
		}
	} catch {
		/* ignore */
	}
	return { cold, hot, recent: { cold: recentCold, hot: recentHot } };
}

// ── Current topic: keywords from the latest user prompt, matched to cold domains ─
const STOPWORDS = new Set(
	"the a an and or but if then else for to of in on at by with from as is are was were be been being do does did have has had this that these those it its what which who whom whose when where why how not no so too very just about into over under again further then once here there all any both each few more most other some such only own same than can will should now your you our their they them we us me my".split(
		" ",
	),
);

function readColdCategoryNames(): Set<string> {
	const names = new Set<string>();
	try {
		if (!fs.existsSync(COLD_DIR)) return names;
		for (const f of fs.readdirSync(COLD_DIR)) {
			if (f.endsWith(".json")) names.add(f.replace(/\.json$/, "").toLowerCase());
		}
	} catch {
		/* ignore */
	}
	return names;
}

// Smoke / test markers that have polluted hot memory on this box
// (smoke-1787XXXXXX-XX, verify-* ids, etc). The previous code happily
// surfaced them as "topics" — useless noise. User feedback 2026-08-20.
const NOISE_PATTERNS = [
	/^smoke[-_]?\d/i,
	/^\d{6,}$/, // pure-numeric tokens (timestamps, pids, unix ts)
	/^verify[-_]?/i,
	/^test[-_]?/i,
	/^[a-f0-9]{8,}$/i, // hex hashes
];

function isNoise(word: string): boolean {
	return NOISE_PATTERNS.some((re) => re.test(word));
}

function extractTopic(): string {
	try {
		const hotFile = path.join(HOT_DIR, "cortexagent.jsonl");
		if (!fs.existsSync(hotFile)) return "";
		const lines = fs.readFileSync(hotFile, "utf8").split("\n");
		// Scan at most the last 50 user prompts so a buried real question
		// isn't masked by 30 minutes of smoke tests.
		const userLines: string[] = [];
		for (let i = lines.length - 1; i >= 0 && userLines.length < 50; i--) {
			const line = lines[i].trim();
			if (!line) continue;
			try {
				const e = JSON.parse(line);
				let role = String(e.role ?? "");
				let content = String(e.content ?? "");
				if (role !== "user" && (content === "user" || content === "assistant" || content === "system")) {
					[role, content] = [content, role];
				}
				if (role === "user") userLines.push(content);
			} catch {
				/* skip unparseable line */
			}
		}
		const cats = readColdCategoryNames();
		for (const content of userLines) {
			// Skip smoke-test-looking prompts outright so a single
			// genuine question buried in test traffic wins.
			if (/^smoke[-_]?\d/i.test(content.trim())) continue;
			const words = content
				.toLowerCase()
				.split(/[^a-z0-9]+/)
				.filter((w) => w.length >= 5 && !STOPWORDS.has(w) && !isNoise(w));
			if (!words.length) continue;
			// Rank: cold-domain matches first, then longer words.
			const ranked = words.sort((a, b) => {
				const aCat = cats.has(a) ? 1 : 0;
				const bCat = cats.has(b) ? 1 : 0;
				if (aCat !== bCat) return bCat - aCat;
				return b.length - a.length;
			});
			const top = ranked.slice(0, 2);
			if (top.length) return top.join(" · ");
		}
	} catch {
		/* no hot store */
	}
	return "";
}

// ── Box-drawing helpers ─────────────────────────────────────────────────────
// Width math is done in VISIBLE cells, not String.length. Both `title` (via
// theme.fg) and `content` (via theme.fg / truncateToWidth) carry ANSI escape
// sequences that inflate String.length without contributing display cells.
// padEnd/repeat against String.length under-fills the panel and breaks the
// borders when they're stacked side-by-side with panelBottom (which has no
// ANSI and therefore hits exactly w cells).
function panelTop(title: string, w: number): string {
	const inner = w - 2;
	const t = ` ${title} `;
	const tVisible = visibleWidth(t);
	if (tVisible >= inner) return `┌${truncateToWidth(t, inner, "…", false)}┐`;
	return `┌${t}${"─".repeat(inner - tVisible)}┐`;
}

function panelRow(content: string, w: number): string {
	const inner = w - 2;
	const c = truncateToWidth(content, inner, "…");
	const pad = " ".repeat(Math.max(0, inner - visibleWidth(c)));
	return `│${c}${pad}│`;
}

function panelBottom(w: number): string {
	return `└${"─".repeat(w - 2)}┘`;
}

// Exported for unit testing the width-math invariants.
export const __test = { panelTop, panelRow, panelBottom };

// ── MCP server status blocks (user request 2026-09-19) ─────────────────────
// 2026-09-21: the daemon OWNS the panel — it runs each server one-shot with
// --write-status every 60s into panel-status/. Session-spawned MCP servers
// (multiple generations, often running stale code) still heartbeat into the
// legacy mcp-status/ dir, which the TUI no longer reads; that clobber war
// was why the panel kept showing old wording after code fixes.
const MCP_STATUS_DIR = path.join(HOME, ".cortexagent", "panel-status");
const MCP_MAX_BLOCKS = 9;
const MCP_STALE_MS = 5 * 60 * 1000;

interface McpServerStatus {
	name: string;
	summary: string;
	stale: boolean;
	label?: string;                  // server-provided display name
	icon?: string;                   // server-provided icon
	lines?: string[];                // up to 2 rich content lines
}

function readMcpServers(): McpServerStatus[] {
	try {
		if (!fs.existsSync(MCP_STATUS_DIR)) return [];
		const hidden = new Set<string>();
		try {
			const raw = fs.readFileSync(path.join(MCP_STATUS_DIR, ".hidden.json"), "utf8");
			for (const h of JSON.parse(raw)) hidden.add(String(h));
		} catch { /* no hidden list */ }
		const out: McpServerStatus[] = [];
		for (const f of fs.readdirSync(MCP_STATUS_DIR)) {
			if (out.length >= MCP_MAX_BLOCKS) break;
			if (!f.endsWith(".json") || f.startsWith(".")) continue;
			const name = f.replace(/\.json$/, "");
			if (hidden.has(name)) continue;
			try {
				const d = JSON.parse(fs.readFileSync(path.join(MCP_STATUS_DIR, f), "utf8"));
				const ts = Number(d.ts) || 0;
				out.push({
					name,
					summary: String(d.summary ?? "no data"),
					stale: Date.now() - ts > MCP_STALE_MS,
					label: d.label ? String(d.label) : undefined,
					icon: d.icon ? String(d.icon) : undefined,
					lines: Array.isArray(d.lines)
						? d.lines.map(String).slice(0, 2)
						: undefined,
				});
			} catch { /* skip malformed */ }
		}
		return out;
	} catch {
		return [];
	}
}

// ── Dispatcher queue (user request 2026-09-19): numbered task list ─────────
const DISPATCHER_QUEUE = path.join(HOME, "dispatcher", "data", "queue.jsonl");

interface DispatcherTask {
	n: number;
	state: string;
	title: string;
}

// Done/canceled tasks are pruned from the dispatcher ledger itself
// (scheduler._prune_terminal), so they simply vanish here. Blocked tasks
// stay visible as ⨯ rows (user request 2026-09-22: "i dont want hidden
// tasks") until the scheduler's 24h blocked-retention prunes them.
const TERMINAL_STATES = new Set(["done", "canceled"]);
// States that are actively being processed — rendered with the spinner.
const ACTIVE_STATES = new Set(["running", "claimed", "ready", "optimizing"]);

function readDispatcherTasks(max = 6): { tasks: DispatcherTask[]; total: number; terminal: number; ok: boolean } {
	const tasks: DispatcherTask[] = [];
	try {
		if (!fs.existsSync(DISPATCHER_QUEUE)) return { tasks, total: 0, terminal: 0, ok: false };
		const lines = fs.readFileSync(DISPATCHER_QUEUE, "utf8").trim().split("\n");
		// Rebuild per-task state: last-write-wins by line order.
		// Only process "add" lines (not "state" ops — state changes
		// are sidecar mutations applied to the same task entry).
		const byId = new Map<string, { state?: string; task?: string; title?: string; priority?: string; added?: string }>();
		for (const line of lines) {
			if (!line.trim()) continue;
			let rec: any;
			try { rec = JSON.parse(line); } catch { continue; }
			if (rec.op !== "add") continue;
			const id = String(rec.id ?? "");
			if (!id) continue;
			byId.set(id, {
				state: rec.state ?? "pending",
				task: rec.task,
				title: rec.task,
				priority: rec.priority,
				added: rec.added,
			});
		}
		// Apply "state" ops: they update state (and optionally result/note).
		for (const line of lines) {
			if (!line.trim()) continue;
			let rec: any;
			try { rec = JSON.parse(line); } catch { continue; }
			if (rec.op !== "state") continue;
			const id = String(rec.id ?? "");
			const entry = byId.get(id);
			if (entry) entry.state = rec.state ?? entry.state;
		}
		const all = Array.from(byId.values());
		const live = all.filter((t) => !TERMINAL_STATES.has(t.state ?? ""));
		const terminal = all.length - live.length;
		// live work first (running/ready), then pending, then the rest —
		// but keep insertion order inside each bucket.
		const rank = (s: string) =>
			s === "running" || s === "claimed" || s === "ready" ? 0
				: s === "pending" || s === "flagged" ? 1 : 2;
		const sorted = [...live].sort((a, b) => rank(a.state ?? "") - rank(b.state ?? ""));
		for (const t of sorted.slice(0, max)) {
			const raw = sanitize(String(t.task ?? t.title ?? "")).slice(0, 60);
			if (!raw) continue;
			tasks.push({ n: tasks.length + 1, state: t.state ?? "?", title: raw });
		}
		return { tasks, total: live.length, terminal, ok: true };
	} catch {
		return { tasks, total: 0, terminal: 0, ok: false };
	}
}

const STATE_GLYPH: Record<string, string> = {
	running: "▶", claimed: "▶", ready: "▶",
	pending: "·", flagged: "!", done: "✓", blocked: "⨯",
};

// ── Component: compact 3-panel bordered status table ────────────────────────
export class StatusPanelsComponent implements Component {
	private frame = 0;
	private timer: NodeJS.Timeout | null = null;
	private lastDataHash = "";
	private flashTimer: NodeJS.Timeout | null = null;
	private readonly onTick?: () => void;

	constructor(onTick?: () => void) {
		this.onTick = onTick;
		this.timer = setInterval(() => {
			this.frame = (this.frame + 1) % SPINNER.length;
			this.onTick?.();
		}, 500);
	}

	dispose(): void {
		if (this.timer) clearInterval(this.timer);
		this.timer = null;
	}

	invalidate(): void {
		// Data is re-read on every render; nothing to cache.
	}

	render(width: number): string[] {
		const gap = 1;
		const panelW = Math.max(14, Math.floor((width - gap * 2) / 3));
		const spinner = SPINNER[this.frame];

		// Panel 1: Compression
		const s = readSlimToken();
		// Detect data change → flash effect
		const dataHash = `${s.ratio}-${s.runs}-${s.tokensIn}-${s.tokensOut}`;
		const changed = s.ok && dataHash !== this.lastDataHash;
		this.lastDataHash = dataHash;
		if (changed) {
			if (this.flashTimer) clearTimeout(this.flashTimer);
			this.flashTimer = setTimeout(() => {
				this.flashTimer = null;
				this.onTick?.();
			}, 1200);
		}
		const compTitle = theme.fg("dim", "⚡ Compression");
		const compL1 = s.ok
			? `${spinner} ${
					changed
						? theme.fg("success", `${s.ratio.toFixed(0)}% saved ✓`)
						: theme.fg("success", `${s.ratio.toFixed(0)}% saved`)
				} · ${s.runs} runs`
			: `${spinner} ${theme.fg("muted", "no data yet")}`;
		const compL2 = s.ok
			? `${formatNum(s.tokensIn)} in → ${formatNum(s.tokensOut)} out`
			: theme.fg("muted", "waiting for first run");

		// Panel 2: Memory — recent additions + current topic. User feedback
		// 2026-08-20: "30 cold, 29 hot, that doesn't help at all. I don't
		// need to see those numbers. I want to see recent additions,
		// topics. That's it."
		const { recent } = readMemoryCounts();
		const topic = extractTopic();
		const memTitle = theme.fg("dim", "🧠 Memory");
		const last24 = recent.cold + recent.hot;
		const memL1 =
			last24 > 0 ? `${theme.fg("success", "+")}${last24} recent` : theme.fg("warning", "no recent writes");
		const memL2 = topic ? `topic: ${theme.fg("accent", topic)}` : theme.fg("muted", "topic: —");

		// Panel 3: Tasks — STATIC summary only. No cycling, no +N more
		// counter twitching. User feedback 2026-08-20: "+3, +2, +7, +8
		// constantly jumping, it's freaking me out." Just show the
		// most-active task title + total count + percentage active.
		const { missing } = readScheduler();
		const live = readLiveActivity();
		const taskTitle = theme.fg("dim", "📅 Tasks");
		let taskL1: string;
		let taskL2: string;
		if (missing) {
			taskL1 = theme.fg("muted", "no scheduler");
			taskL2 = theme.fg("muted", "scheduler offline");
		} else if (live.length === 0) {
			const recent = countRecentCompleted();
			// 2026-08-21: surface the SCHEDULED count too — the panel
			// was permanently "no active jobs" / "0 done recently"
			// which read as broken even when 12 tasks were queued in
			// the scheduler. Show the scheduled queue depth so the
			// user knows work IS waiting even when nothing is firing.
			const scheduledCount = (() => {
				try {
					const d = JSON.parse(fs.readFileSync(SCHEDULER_FILE, "utf8"));
					const arr: any[] = Array.isArray(d.tasks)
						? d.tasks
						: d && typeof d === "object" && !Array.isArray(d)
							? Object.values(d)
							: [];
					return arr.filter((t) => String(t.state ?? t.status ?? "scheduled") === "scheduled").length;
				} catch {
					return 0;
				}
			})();
			taskL1 = theme.fg("success", "✓ idle");
			if (recent > 0 && scheduledCount > 0) {
				taskL2 = theme.fg("muted", `${recent} done · ${scheduledCount} queued`);
			} else if (recent > 0) {
				taskL2 = theme.fg("muted", `${recent} done recently`);
			} else if (scheduledCount > 0) {
				taskL2 = theme.fg("muted", `${scheduledCount} queued`);
			} else {
				taskL2 = theme.fg("muted", "no active jobs");
			}
		} else {
			// First running or queued task; fall back to first scheduled.
			const top = live.find((t) => t.state === "running") ?? live.find((t) => t.state === "queued") ?? live[0]!;
			const topTitle = sanitize(top.title || top.id.slice(0, 8));
			const running = live.filter((t) => t.state === "running").length;
			const pct = live.length > 0 ? Math.round((running / live.length) * 100) : 0;
			taskL1 = `${theme.fg("accent", "▶")} ${topTitle}`;
			taskL2 = `${live.length} active · ${pct}% running`;
		}

		// Assemble the grid (user request 2026-09-21, refining 2026-09-19):
		//   row 1: [Compression][Memory][Tasks  ]    Tasks is a TALL box that
		//   row 2: [☁️ Cloud Management ][Tasks  ]   spans both rows and lists
		// the dispatcher queue. Cloud Management is ONE wide box (spans the
		// two columns left of Tasks — user request 2026-09-21: "one large
		// cloud management box with a separate dispatcher/messenger/secops
		// section all in one box; it shouldn't split like that").
		const rows: string[] = [];
		const dq = readDispatcherTasks(5);
		const taskLines: string[] = [];
		if (!dq.ok) {
			taskLines.push(theme.fg("muted", "no dispatcher queue"));
		} else if (dq.tasks.length === 0) {
			taskLines.push(theme.fg("muted", "queue empty"));
		} else {
			for (const t of dq.tasks) {
				// 2026-09-22 user request: active tasks get the spinning
				// animation (same frames as the compression panel); blocked
				// shows ⨯ in warning color instead of being hidden.
				const active = ACTIVE_STATES.has(t.state);
				const g = active ? SPINNER[this.frame] : (STATE_GLYPH[t.state] ?? "·");
				const c = active ? "accent"
					: g === "!" || g === "⨯" ? "warning"
					: g === "✓" ? "success"
					: "muted";
				taskLines.push(
					`${theme.fg("dim", `${t.n}.`)} ${theme.fg(c, g)} ${t.title}`,
				);
			}
			if (dq.total > dq.tasks.length) {
				taskLines.push(theme.fg("muted", `+${dq.total - dq.tasks.length} more in queue`));
			}
		}
		while (taskLines.length < 7) taskLines.push("");

		const mcp = readMcpServers();
		const cloudLines: string[] = [];
		if (mcp.length === 0) {
			cloudLines.push(theme.fg("muted", "no servers reporting"));
			cloudLines.push(theme.fg("muted", "/mcp-panels to toggle"));
		} else {
			const shown = mcp.slice(0, 3);
			for (const srv of shown) {
				const title = srv.label ?? srv.name;
				const line = srv.lines?.[0] ?? srv.summary;
				cloudLines.push(
					`${srv.icon ?? "🔌"} ${theme.fg(srv.stale ? "warning" : "success", title)} ${theme.fg(srv.stale ? "warning" : "muted", "—")} ${srv.stale ? theme.fg("warning", `${line} · stale >5min`) : theme.fg("success", line)}`,
				);
			}
			if (mcp.length > 3) {
				cloudLines.push(theme.fg("muted", `+${mcp.length - 3} more: ${mcp.slice(3).map((x) => x.name).join(", ")}`));
			}
		}

		const w = panelW;
		const cell = (content: string, width: number) => {
			const inner = width - 2;
			const c = truncateToWidth(content, inner, "…");
			const pad = " ".repeat(Math.max(0, inner - visibleWidth(c)));
			return `│${c}${pad}│`;
		};
		// 2026-09-23: big ☁️ (U+2601+VS16) restored per owner request. The
		// 2026-09-21 border collision was NOT a width bug: visibleWidth
		// (tui/utils.ts graphemeWidth) already counts '☁️' as 2 cells via
\pRGI_Emoji, so panelTop pads correctly. Geometry unchanged.
		const cw = w * 2 + gap;                       // Cloud Mgmt spans cols 1-2
		// row 1: comp, memory, tasks(top)
		rows.push(`${panelTop(compTitle, w)}${" ".repeat(gap)}${panelTop(memTitle, w)}${" ".repeat(gap)}${panelTop(taskTitle, w)}`);
		rows.push(`${cell(compL1, w)}${" ".repeat(gap)}${cell(memL1, w)}${" ".repeat(gap)}${cell(taskLines[0], w)}`);
		rows.push(`${cell(compL2, w)}${" ".repeat(gap)}${cell(memL2, w)}${" ".repeat(gap)}${cell(taskLines[1], w)}`);
		rows.push(`${panelBottom(w)}${" ".repeat(gap)}${panelBottom(w)}${" ".repeat(gap)}${cell(taskLines[2], w)}`);
		// row 2: ONE Cloud Management box (3 section rows) + tasks continues
		rows.push(`${panelTop(theme.fg("dim", "☁️ Cloud Management"), cw)}${" ".repeat(gap)}${cell(taskLines[3], w)}`);
		rows.push(`${cell(cloudLines[0] ?? "", cw)}${" ".repeat(gap)}${cell(taskLines[4], w)}`);
		rows.push(`${cell(cloudLines[1] ?? "", cw)}${" ".repeat(gap)}${cell(taskLines[5], w)}`);
		rows.push(`${cell(cloudLines[2] ?? "", cw)}${" ".repeat(gap)}${cell(taskLines[6], w)}`);
		rows.push(`${panelBottom(cw)}${" ".repeat(gap)}${panelBottom(w)}`);
		return rows;
	}
}
