{
  "name": "@cortexagent/protocol",
  "version": "0.7.3.2",
  "description": "cortexagent \u2014 hardened, fully offline agent wired to its own local models (compiled core, frozen tree)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cortex",
    "protocol",
    "cbor",
    "binary",
    "framing"
  ],
  "author": "GreyOK00",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  }
}
