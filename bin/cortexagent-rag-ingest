#!/usr/bin/env python3
"""bin/cortexagent-rag-ingest — bulk ingest security research notes into cortexllm RAG.

Reads each note in ~/.claude/projects/-home-grey/memory/security-research-*.md,
chunks it, and ingests it into the cortexllm domain_db via lib.domain_ingest.
Re-running is safe — duplicates dedupe by content hash.

Domains are chosen by topic:
  siem-soar / lsm-nft-dns / linux-hardening / cve-mitre → 'dfir'
  (DFIR covers defensive forensics, vuln mgmt, hardening — natural fit)

Idempotent. Run any time new research notes are added.
"""
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from lib import domain_ingest  # noqa: E402

MEMORY_DIR = Path.home() / ".claude" / "projects" / "-home-grey" / "memory"
PATTERN = re.compile(r"^security-research-.*\.md$")

DOMAIN = "dfir"

# Skip these — not bulk-ingest material
SKIP_KEYWORDS = ("-integration.md", "-shipped.md", "-complete.md",
                 "-fix.md", "-autostart-service.md", "-research-first")


def _should_skip(name: str) -> bool:
    return any(kw in name for kw in SKIP_KEYWORDS)


def main() -> int:
    if not MEMORY_DIR.exists():
        print(f"❌ memory dir missing: {MEMORY_DIR}")
        return 1
    notes = sorted(p for p in MEMORY_DIR.glob("security-research-*.md")
                   if PATTERN.match(p.name) and not _should_skip(p.name))
    if not notes:
        print(f"⚠ no research notes match in {MEMORY_DIR}")
        return 0
    total_chunks = 0
    print(f"📚 Ingesting {len(notes)} research notes → domain={DOMAIN}")
    for path in notes:
        text = path.read_text()
        # Drop YAML frontmatter
        body = re.sub(r"^---\n.*?\n---\n", "", text, count=1, flags=re.S)
        # Use filename as source so re-ingest dedupes
        source = f"security-research/{path.name}"
        r = domain_ingest.ingest(DOMAIN, source, body)
        if not r.get("ok"):
            print(f"  ❌ {path.name}: {r.get('error', 'unknown')[:120]}")
            continue
        chunks = r.get("chunks", 0)
        total_chunks += chunks
        print(f"  ✓ {path.name:60s} {chunks:4d} chunks")
    print(f"\n✅ Done. {total_chunks} new chunks indexed across {len(notes)} notes.")
    print(f"   Query via:  python3 -c \"from lib import domain_db; print(domain_db.search('{DOMAIN}', 'landlock', limit=5))\"")
    return 0


if __name__ == "__main__":
    sys.exit(main())
