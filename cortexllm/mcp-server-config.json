{
  "mcpServers": {
    "cortexllm": {
      "command": "python3",
      "args": ["<CORTEXLLM_REPO>/cortexllm_mcp_server.py"],
      "env": {
        "PYTHONPATH": "<CORTEXLLM_REPO>"
      },
      "description": "CortexLLM Unified Memory System - Universal memory for MCP-compatible agents",
      "capabilities": [
        "memory_read",
        "memory_write",
        "memory_search",
        "memory_clear"
      ]
    }
  }
}