[Unit]
Description=CortexAgent system tray (linked to overseer)
Documentation=https://github.com/greyok00/cortexagent
After=network.target cortexagent-overseer.service graphical-session.target
Wants=cortexagent-overseer.service

[Service]
Type=simple
ExecStart={{PYTHON}} -m lib.tray
WorkingDirectory={{REPO_ROOT}}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=CORTEXAGENT_REPO={{REPO_ROOT}}
Environment=CORTEXAGENT_STATE_DIR=%h/.cortexagent
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
