[Unit]
Description=CortexAgent stealth Chrome (Patchright/Chrome + CDP on :9222)
Documentation=https://github.com/greyok00/cortexagent
# Headless Chromium on virtual display :99. Replaces the old Brave + CDP
# on :9222 stack that was getting wedged by Brave Shields (DOM guard
# injection, blocked trackers, modified navigator objects).
#
# Standalone. Does NOT depend on cortexagent-tray / cortexagent-daemon /
# overseer. The user can run this all night for clickworker / scraper
# jobs without touching the main chat session.
After=graphical-session.target

[Service]
Type=simple
ExecStart={{CHROME}} \
  --remote-debugging-port={{CDP_PORT}} \
  --remote-debugging-address=127.0.0.1 \
  --user-data-dir={{USER_DATA_DIR}} \
  --disable-blink-features=AutomationControlled \
  --disable-background-timer-throttling \
  --disable-backgrounding-occluded-windows \
  --disable-renderer-backgrounding \
  --disable-ipc-flooding-protection \
  --no-first-run \
  --no-default-browser-check \
  --no-sandbox \
  about:blank
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=DISPLAY=:99
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
